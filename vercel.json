{
  "framework": null,
  "buildCommand": "npm run build:vercel",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "headers": [
    {
      "source": "/JARVIS.exe",
      "headers": [
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"JARVIS.exe\""
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
