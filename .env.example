# Copy this file to %LOCALAPPDATA%\JARVIS\.env and add your own keys.
# Never commit the populated file.
GROQ_API_KEY=
CEREBRAS_API_KEY=
CEREBRAS_API_KEY1=
OPENROUTER_API_KEY=

# JARVIS refuses non-free OpenRouter model IDs.
JARVIS_FREE_MODELS_ONLY=true

# Optional: point JARVIS directly at an OpenAI-compatible local gateway.
# When enabled, JARVIS starts a locally installed OmniRoute automatically.
JARVIS_BASE_URL=http://127.0.0.1:20128/v1
JARVIS_MODEL=
JARVIS_AUTOSTART_OMNIROUTE=true
